NEXT_PUBLIC_SITE_URL=https://storyforge-bland.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
UPSTASH_QSTASH_TOKEN=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# --- AI provider (OpenRouter migration, roadmap P1-01) ---
# Server-side ONLY. NEVER prefix with NEXT_PUBLIC_ (that would leak the key to the browser).
AI_PROVIDER=anthropic            # 'anthropic' (current fallback) | 'openrouter'
OPENROUTER_API_KEY=
# --- Spend kill switch (roadmap P1-08, Build Spec §4.1); values in IDR ---
DAILY_AI_SPEND_LIMIT_IDR=100000
MONTHLY_AI_SPEND_LIMIT_IDR=
PER_USER_DAILY_AI_COST_LIMIT_IDR=
AI_PROVIDER_FAIL_CLOSED=true

# --- Usage enforcement kill-switch (P0 rollout/rollback) ---
# "false" = measure-only (counters/events still recorded via service role, but
# the cap never blocks). Any other value / unset = enforcement ON (safe default).
# Set to "false" for the measure-only compat deploy; flip to "true" to go live;
# flip back to "false" to disable enforcement instantly without a schema change.
USAGE_ENFORCEMENT_ENABLED=true

# Set to "true" to enable the V2 analysis engine (Gap Cards, Journey Map,
# Score Breakdown). REQUIRES migration 009_enhance_analysis_results_v2.sql to be
# applied to Supabase first — enabling without the migration breaks session save.
# Leave empty/false to keep the legacy analysis output.
ANALYSIS_V2_ENABLED=
